{
  "name": "qq-ai-sing",
  "version": "0.1.0",
  "private": true,
  "description": "Make a QQ chat agent actually sing: lossless source -> UVR separation -> RVC voice conversion -> mix QA -> QQ delivery. Ships no voice models.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "doctor": "python scripts/doctor.py",
    "hash-models": "python scripts/hash-models.py",
    "test": "python -B -m unittest discover -s pipeline/hq_cover/tests -t pipeline -p \"test_*.py\"",
    "test:bridge": "node bridge/src/selftest.mjs && node bridge/src/selftest-mcp.mjs",
    "test:all": "npm run test && npm run test:bridge",
    "check-deps": "node scripts/check-deps.mjs",
    "verify:mcp": "node scripts/verify-mcp-tools.mjs",
    "wire": "node scripts/wire-all.mjs",
    "render:chorus": "cd pipeline && python -m hq_cover.jobs render --song \"示例歌曲 示例歌手\" --mode chorus --out ../test-run"
  },
  "keywords": [
    "qq",
    "rvc",
    "voice-conversion",
    "ai-cover",
    "uvr",
    "snowluma"
  ],
  "author": "lijiyang2007 (https://github.com/lijiyang2007)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijiyang2007/qq-ai-sing.git"
  },
  "bugs": {
    "url": "https://github.com/lijiyang2007/qq-ai-sing/issues"
  },
  "homepage": "https://github.com/lijiyang2007/qq-ai-sing#readme",
  "dependencies": {}
}
